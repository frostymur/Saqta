# Public MQTT demo. Keep the prefix unique for your team/event and use the
# same prefix in arduino/floodwatch_station/floodwatch_station.ino.
MQTT_ENABLED=true
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=saqta/floodwatch/sko-demo/telemetry/#
MQTT_STATUS_TOPIC=saqta/floodwatch/sko-demo/status/#
# Optional credentials for a private broker:
MQTT_USERNAME=
MQTT_PASSWORD=
